    // Переключение вкладок
    function switchTab(tabId) {
      ['catalog', 'equipment', 'chat'].forEach(id => {
        const el = document.getElementById(`tab-${id}`);
        const desktopBtn = document.getElementById(`nav-btn-${id}`);
        const mobBtn = document.getElementById(`mob-btn-${id}`);
        
        if (id === tabId) {
          el.classList.remove('hidden');
          if (desktopBtn) {
            desktopBtn.classList.add('text-brand-amber', 'bg-brand-card', 'border', 'border-brand-border');
            desktopBtn.classList.remove('text-brand-textMuted');
          }
          if (mobBtn) {
            mobBtn.classList.add('text-brand-amber');
            mobBtn.classList.remove('text-brand-textMuted');
          }
        } else {
          el.classList.add('hidden');
          if (desktopBtn) {
            desktopBtn.classList.remove('text-brand-amber', 'bg-brand-card', 'border', 'border-brand-border');
