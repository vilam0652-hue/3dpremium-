          document.getElementById('promo-scene-title').innerText = scene.title;
          document.getElementById('promo-scene-subtitle').innerText = scene.subtitle;
        }

        if (elapsed >= duration) {
          clearInterval(promoInterval);
          promoInterval = null;
          laserEl.classList.add('hidden');
          statusLabel.innerHTML = `<i class="fa-solid fa-check-circle text-brand-amber mr-1"></i> Презентация завершена! Выберите фигурку в каталоге.`;
        }
      }, 80);
