    function initChatSync() {
      const logged = window.appState?.loggedAccount;
      if (!userChatRoomId) {
        userChatRoomId = logged ? `user_${logged.username}` : (window.appState?.user?.uid || ('guest_' + Math.random().toString(36).substring(2, 7)));
        window.appState.activeChatRoomId = userChatRoomId;
