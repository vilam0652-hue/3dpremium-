      playAmbientSoundscape();

      // Запускаем приятную русскую голосовую озвучку через Web Speech API
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const voiceText = "Добро пожаловать в Лейер Лаб! У нас вы можете купить коллекционные три-дэ фигурки, подвижных драконов и меха-роботов. Мы печатаем каждую деталь на флагманском принтере Бамбу Лаб А-один из фирменных катушек с идеальной гладкостью. Выбирайте фигурку на витрине и заказывайте прямо сейчас!";
        const utterance = new SpeechSynthesisUtterance(voiceText);
        utterance.lang = 'ru-RU';
        utterance.rate = 1.08; // Динамичный темп на 10 секунд
        utterance.pitch = 1.05; // Приятный мягкий тембр

        const voices = window.speechSynthesis.getVoices();
        const ruVoice = voices.find(v => v.lang.includes('ru') && (v.name.includes('Google') || v.name.includes('Irina') || v.name.includes('Milena') || v.name.includes('Natural'))) || voices.find(v => v.lang.includes('ru'));
        if (ruVoice) utterance.voice = ruVoice;

        window.speechSynthesis.speak(utterance);
      }

      const startTime = performance.now();
      const duration = 10000; // ровно 10.0 секунд

      promoInterval = setInterval(() => {
        const elapsed = performance.now() - startTime;
        const sec = Math.min(10.0, elapsed / 1000);
        const pct = Math.min(100, (elapsed / duration) * 100);

        progressBar.style.width = `${pct}%`;
        timeCounter.innerText = `${sec.toFixed(1).padStart(4, '0')} / 10.0 сек`;

        // Обновляем сцену
        const scene = PROMO_SCENES.find(s => sec >= s.timeStart && sec <= s.timeEnd) || PROMO_SCENES[PROMO_SCENES.length - 1];
