    /* Анимации для 10-секундного промо-ролика */
    @keyframes scanline {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(400%); }
    }
    .laser-scan {
      animation: scanline 2.5s linear infinite;
    }

    /* Адаптивная высота чата для мобильных (с учётом клавиатуры и адресной строки) */
    .mobile-chat-height {
      height: calc(100dvh - 190px);
    }
    @media (min-width: 1024px) {
      .mobile-chat-height {
        height: 640px;
      }
    }
  </style>
