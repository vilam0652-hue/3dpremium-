        if (payload.deletedIds && window.appState) {
          window.appState.deletedIds = new Set(payload.deletedIds);
        }
        renderProducts(currentProductsList);
      } else if (type === 'NEW_CHAT_MESSAGE') {
        handleIncomingBroadcastMessage(payload);
      } else if (type === 'USER_REGISTERED') {
        if (window.appState) {
          window.appState.registeredUsers[payload.username] = payload;
        }
      }
