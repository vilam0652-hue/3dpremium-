    function handleAccountLogin(e) {
      e.preventDefault();
      const rawUser = document.getElementById('login-username').value.trim().toLowerCase();
      const rawPass = document.getElementById('login-password').value.trim();
      const errEl = document.getElementById('login-error-msg');
      errEl.classList.add('hidden');

      // Проверка аккаунта Разработчика
      if (DEVELOPER_CREDENTIALS.usernames.includes(rawUser) && DEVELOPER_CREDENTIALS.passwords.includes(rawPass)) {
        const account = {
          username: rawUser,
          displayName: DEVELOPER_CREDENTIALS.displayName,
          role: 'developer'
        };
        activateSessionAccount(account);
        closeModal('modal-account');
        e.target.reset();
        showToast('Вход выполнен: Аккаунт Разработчика');
        return;
      }

      // Проверка зарегистрированных покупателей
      const existingBuyer = window.appState.registeredUsers[rawUser];
      if (existingBuyer && existingBuyer.password === rawPass) {
        const account = {
          username: existingBuyer.username,
          displayName: existingBuyer.displayName,
          role: 'buyer'
        };
        activateSessionAccount(account);
        closeModal('modal-account');
        e.target.reset();
        showToast(`Добро пожаловать, ${account.displayName}!`);
        return;
      }

      errEl.innerText = 'Неверное имя аккаунта или пароль. Для разработчика: developer / admin123';
      errEl.classList.remove('hidden');
    }

    async function handleAccountRegister(e) {
      e.preventDefault();
      const displayName = document.getElementById('reg-displayname').value.trim();
      const username = document.getElementById('reg-username').value.trim().toLowerCase();
      const password = document.getElementById('reg-password').value.trim();
      const errEl = document.getElementById('reg-error-msg');
      errEl.classList.add('hidden');

      if (DEVELOPER_CREDENTIALS.usernames.includes(username)) {
        errEl.innerText = 'Этот логин зарезервирован за Разработчиком!';
        errEl.classList.remove('hidden');
        return;
      }

      if (password.length < 4) {
        errEl.innerText = 'Пароль должен быть не короче 4 символов';
        errEl.classList.remove('hidden');
        return;
      }

      if (window.appState.registeredUsers[username]) {
        errEl.innerText = 'Такой логин уже занят другим покупателем!';
        errEl.classList.remove('hidden');
        return;
      }

      const newBuyer = {
        username,
        displayName,
        password,
        role: 'buyer',
        createdAt: Date.now()
      };

      window.appState.registeredUsers[username] = newBuyer;
      realtimeBus.postMessage({ type: 'USER_REGISTERED', payload: newBuyer });

      const { db, appId, isFirebaseReady } = window.appState || {};
      if (isFirebaseReady && db && window.appState.user) {
        try {
          const { doc, setDoc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
          await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'users', username), newBuyer);
        } catch (err) {
          console.warn("Локальная регистрация:", err);
        }
      }

      activateSessionAccount({
        username,
        displayName,
        role: 'buyer'
      });

      closeModal('modal-account');
      e.target.reset();
      showToast(`Аккаунт @${username} успешно создан!`);
    }

    function activateSessionAccount(account) {
      window.appState.loggedAccount = account;
      window.appState.isAdmin = (account.role === 'developer');

      const headerText = document.getElementById('account-header-text');
      const mobLabel = document.getElementById('mob-admin-label');
      const roleBadge = document.getElementById('user-role-badge');

      if (account.role === 'developer') {
        headerText.innerText = 'Разработчик';
        mobLabel.innerText = 'Админ';
        roleBadge.innerText = 'Разработчик (Master)';
