    import { 
      getAuth, 
      signInAnonymously, 
      signInWithCustomToken 
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import { 
      getFirestore, 
      collection, 
      doc, 
      setDoc, 
      getDoc,
      getDocs, 
      addDoc, 
      deleteDoc, 
      onSnapshot 
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    let firebaseConfig = typeof __firebase_config !== 'undefined' 
      ? JSON.parse(__firebase_config) 
      : null;

    if (!firebaseConfig && window.customFirebaseConfigJson) {
      try { firebaseConfig = JSON.parse(window.customFirebaseConfigJson); } catch(e) {}
    }

    if (!firebaseConfig) {
      firebaseConfig = {
        apiKey: "demo-api-key",
        authDomain: "layer-lab-demo.firebaseapp.com",
        projectId: "layer-lab-demo",
        storageBucket: "layer-lab-demo.appspot.com",
        messagingSenderId: "1234567890",
        appId: "1:1234567890:web:demo"
      };
    }

    const appId = typeof __app_id !== 'undefined' ? __app_id : 'layer-lab-store';

    let app, auth, db, currentUser = null;
    let isFirebaseReady = false;

    try {
      app = initializeApp(firebaseConfig);
      auth = getAuth(app);
      db = getFirestore(app);

      if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
        await signInWithCustomToken(auth, __initial_auth_token);
      } else {
        await signInAnonymously(auth);
      }
      currentUser = auth.currentUser;
      isFirebaseReady = true;
    } catch (err) {
      console.warn("Локальный режим синхронизации:", err);
      currentUser = { uid: 'user-' + Math.random().toString(36).substring(2, 9) };
    }

    window.appState = {
      db,
      auth,
      appId,
      user: currentUser,
      isAdmin: false,
      loggedAccount: null, // { username, displayName, role: 'developer' | 'buyer' }
      activeChatRoomId: null,
      isFirebaseReady,
      currentOrderedProduct: null,
      productToDeleteId: null,
      deletedIds: new Set(),
      registeredUsers: {}
    };

    initUsersSync();
    initCatalogSync();
    initChatSync();
  </script>

