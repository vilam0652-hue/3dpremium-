    function stopPromoVideo() {
      if (promoInterval) {
        clearInterval(promoInterval);
        promoInterval = null;
      }
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      if (promoAudioCtx) {
        try { promoAudioCtx.close(); } catch(e) {}
        promoAudioCtx = null;
      }
      document.getElementById('promo-laser')?.classList.add('hidden');
