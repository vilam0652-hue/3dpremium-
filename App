    // ==================== КАТАЛОГ ТОВАРОВ И НАДЁЖНОЕ УДАЛЕНИЕ У ВСЕХ ====================
    let currentProductsList = [...DEFAULT_PRODUCTS];
    let isSeedingCatalog = false;

    function initCatalogSync() {
      const { db, appId, isFirebaseReady } = window.appState || {};

      if (isFirebaseReady && db && window.appState.user) {
        import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js").then(({ collection, onSnapshot }) => {
          const colRef = collection(db, 'artifacts', appId, 'public', 'data', 'products');
          
          onSnapshot(colRef, (snapshot) => {
            const rawDocs = [];
            let hasMetaDoc = false;
            let metaDeletedIds = [];

            snapshot.forEach(docSnap => {
              if (docSnap.id === '__catalog_meta__') {
                hasMetaDoc = true;
                metaDeletedIds = docSnap.data().deletedIds || [];
              } else {
                rawDocs.push({ id: docSnap.id, ...docSnap.data() });
              }
            });

            window.appState.deletedIds = new Set(metaDeletedIds);

            // Если каталог запускается впервые (нет мета-документа и пусто) — засеваем стартовые образцы 1 раз
            if (!hasMetaDoc && rawDocs.length === 0 && !isSeedingCatalog) {
              populateInitialFirestoreCatalog();
              return;
            }

            // Фильтруем удаленные товары, чтобы они НИКОГДА не возвращались
            const visibleItems = rawDocs.filter(item => !window.appState.deletedIds.has(item.id) && !item.deleted);
            visibleItems.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
            currentProductsList = visibleItems;
            renderProducts(currentProductsList);
          }, (err) => {
            console.error("Realtime ошибка каталога:", err);
            renderProducts(currentProductsList);
          });
        });
      } else {
        renderProducts(currentProductsList);
      }
    }

    async function populateInitialFirestoreCatalog() {
      if (isSeedingCatalog) return;
      isSeedingCatalog = true;
      try {
        const { setDoc, doc } = await import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js");
        const { db, appId } = window.appState;
        await setDoc(doc(db, 'artifacts', appId, 'public', 'data', 'products', '__catalog_meta__'), {
          initialized: true,
          deletedIds: [],
          updatedAt: Date.now()
        });
        for (const item of DEFAULT_PRODUCTS) {
          const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'products', item.id);
          await setDoc(docRef, item);
        }
      } catch (e) {
        console.warn("Ошибка первичной инициализации:", e);
      } finally {
        isSeedingCatalog = false;
      }
    }

    function renderProducts(items) {
