      if (isFirebaseReady && db && window.appState.user) {
        import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js").then(({ collection, onSnapshot }) => {
          const messagesCol = collection(db, 'artifacts', appId, 'public', 'data', 'messages');

          onSnapshot(messagesCol, (snapshot) => {
            const allMsgs = [];
            knownChatRooms.clear();

            snapshot.forEach(docSnap => {
              const data = docSnap.data();
              allMsgs.push({ id: docSnap.id, ...data });
              if (data.roomId) {
                const label = data.buyerName || `Клиент #${data.roomId.substring(0, 6)}`;
                knownChatRooms.set(data.roomId, label);
              }
            });

            allMsgs.sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));
            updateAdminRoomsList(knownChatRooms);

            const currentRoom = window.appState.isAdmin ? (window.appState.activeChatRoomId || Array.from(knownChatRooms.keys())[0] || userChatRoomId) : userChatRoomId;
            window.appState.activeChatRoomId = currentRoom;
            chatMessages = allMsgs.filter(m => m.roomId === currentRoom);

            renderChatMessages(chatMessages);
          }, (err) => {
            console.error("Ошибка чата:", err);
            renderChatMessages(chatMessages);
          });
        });
      } else {
        if (chatMessages.length === 0) {
          chatMessages = [
            {
              id: 'welcome-msg',
              sender: 'seller',
              senderName: 'Мастер LAYER LAB',
              text: 'Здравствуйте! Напишите сюда любую модель или вопрос — я отвечу в реальном времени.',
              timestamp: Date.now()
            }
          ];
        }
        renderChatMessages(chatMessages);
      }
    }

