    function playAmbientSoundscape() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        promoAudioCtx = new AudioContext();
        const now = promoAudioCtx.currentTime;

        [220, 277.18, 329.63, 440].forEach((freq) => {
          const osc = promoAudioCtx.createOscillator();
          const gain = promoAudioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);

          gain.gain.setValueAtTime(0.001, now);
          gain.gain.exponentialRampToValueAtTime(0.025, now + 1.5);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 9.8);

          osc.connect(gain);
          gain.connect(promoAudioCtx.destination);
          osc.start(now);
          osc.stop(now + 10);
        });
      } catch (e) {}
    }

