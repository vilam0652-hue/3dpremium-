    // ==================== СИСТЕМА АККАУНТОВ (РАЗРАБОТЧИК + ПОКУПАТЕЛИ) ====================
    function initUsersSync() {
      const { db, appId, isFirebaseReady } = window.appState || {};
      if (isFirebaseReady && db && window.appState.user) {
        import("https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js").then(({ collection, onSnapshot }) => {
          const usersCol = collection(db, 'artifacts', appId, 'public', 'data', 'users');
          onSnapshot(usersCol, (snap) => {
            snap.forEach(docSnap => {
              const u = docSnap.data();
              if (u && u.username) {
                window.appState.registeredUsers[u.username.toLowerCase()] = u;
              }
            });
          }, (err) => console.warn("Синхронизация профилей:", err));
        });
      }
    }

    function openAccountModal() {
      const logged = window.appState?.loggedAccount;
      const loggedView = document.getElementById('account-logged-in-view');
      const formsView = document.getElementById('account-auth-forms-view');
      const devActions = document.getElementById('dev-extra-actions');

      if (logged) {
        loggedView.classList.remove('hidden');
        formsView.classList.add('hidden');
        document.getElementById('logged-user-display').innerText = logged.displayName;
        document.getElementById('logged-user-login').innerText = `@${logged.username}`;
        const roleBadge = document.getElementById('logged-user-role');
        if (logged.role === 'developer') {
          roleBadge.innerText = 'РАЗРАБОТЧИК / АДМИН МАГАЗИНА';
          devActions.classList.remove('hidden');
        } else {
          roleBadge.innerText = 'Покупатель LAYER LAB';
          devActions.classList.add('hidden');
        }
      } else {
        loggedView.classList.add('hidden');
        formsView.classList.remove('hidden');
      }
      openModal('modal-account');
    }

    function switchAuthSubTab(mode) {
      const btnLogin = document.getElementById('tab-auth-login');
      const btnReg = document.getElementById('tab-auth-register');
      const formLogin = document.getElementById('form-login');
      const formReg = document.getElementById('form-register');

